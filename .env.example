# Port aplikasi
PORT=3000

# Batas unduhan bersamaan (concurrency limit)
MAX_CONCURRENT=3

# Batas maksimal durasi video dalam detik (10800 = 3 jam)
MAX_VIDEO_DURATION=10800

# Direktori penyimpanan sementara file unduhan
DOWNLOAD_DIR=./downloads

# Opsional: Path binary khusus jika dijalankan manual tanpa Docker
# YTDL_PATH=./bin/yt-dlp
# FFMPEG_PATH=./bin/ffmpeg
